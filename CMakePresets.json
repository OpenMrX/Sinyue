{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "displayName": "Clang + Ninja + sccache (base)",
      "description": "Shared settings: Ninja generator, LLVM toolchain, sccache launcher, project-local CPM cache.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "environment": {
        "PATH": "$env{ProgramFiles}/LLVM/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_RC_COMPILER": "llvm-rc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_COLOR_DIAGNOSTICS": true,
        "CPM_SOURCE_CACHE": "${sourceDir}/.cpmcache",
        "SINYUE_USE_SCCACHE": true
      }
    },
    {
      "name": "clang-debug",
      "inherits": "clang-base",
      "displayName": "Clang Debug",
      "description": "Unoptimised build with CodeView debug info (PDB) and sccache.",
      "binaryDir": "${sourceDir}/build-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -fno-omit-frame-pointer"
      }
    },
    {
      "name": "clang-release",
      "inherits": "clang-base",
      "displayName": "Clang Release",
      "description": "Optimised build, LTO when the linker supports it, sccache.",
      "binaryDir": "${sourceDir}/build-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "displayName": "Build Clang Debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "displayName": "Build Clang Release",
      "configurePreset": "clang-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "clang-debug",
      "displayName": "Configure + build (Debug)",
      "steps": [
        { "type": "configure", "name": "clang-debug" },
        { "type": "build", "name": "clang-debug" }
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Configure + build (Release)",
      "steps": [
        { "type": "configure", "name": "clang-release" },
        { "type": "build", "name": "clang-release" }
      ]
    }
  ]
}
